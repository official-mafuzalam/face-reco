DB_PATH=data/gate.db
# Generate real values with: python -m tools.generate_env
SECRET_KEY=replace-with-a-long-random-secret
FERNET_KEY=MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA=
TZ=Asia/Dhaka
HOST=127.0.0.1
PORT=8090
# Set to true when the app is served over HTTPS (for example behind a reverse proxy).
COOKIE_SECURE=false
# Only for local development: allows starting with the sample keys above.
ALLOW_INSECURE_DEFAULTS=false
# Remote access via Cloudflare Tunnel
TRUST_CLOUDFLARE=false
# Web push notifications (generated by python -m tools.generate_env)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=admin@gateface.local
# Surveillance: object detection, incidents and clips on every enabled camera.
SURVEILLANCE_ENABLED=true
# Empty = use the frame rate of HARDWARE_PROFILE (cpu_small: 2).
# SURVEILLANCE_FPS=2.0
OBJECT_CONFIDENCE=0.45
INCIDENT_IDLE_SECONDS=6
CLIP_FPS=4
CLIP_MAX_WIDTH=640
CLIP_MAX_SECONDS=60
INCIDENT_MEDIA_RETENTION_DAYS=30
# Login session length in minutes (activity does not extend it yet).
SESSION_IDLE_TIMEOUT_MINUTES=60
PUSH_ENABLED=true
# Detector hardware: cpu_small | cpu_large | openvino | cuda (openvino/cuda need an extra onnxruntime package).
HARDWARE_PROFILE=cpu_small
DETECTOR_BACKEND=auto
# AI verification of incidents with a local VLM through Ollama. Set false when Ollama is not installed.
AI_VERIFY_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5vl:3b
AI_VERIFY_TIMEOUT_SECONDS=15
# Watchdog and disk guard: oldest media is deleted below either free-space limit.
WATCHDOG_ENABLED=true
WATCHDOG_INTERVAL_SECONDS=15
MIN_DISK_FREE_GB=5
MIN_DISK_FREE_PERCENT=10
# Evening push with the day's summary, local time HH:MM. Empty turns it off.
DAILY_SUMMARY_TIME=20:00
